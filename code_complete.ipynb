def set_seed(seed):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)


def _stable_hash(obj):
    payload = json.dumps(obj, sort_keys=True, default=str).encode("utf-8")
    return hashlib.sha256(payload).hexdigest()


def hash_manifest_split(manifest_path, split_col="split", id_col="original_id"):
    df = pd.read_csv(manifest_path)
    pairs = sorted(zip(df[id_col].astype(str), df[split_col].astype(str)))
    return _stable_hash(pairs)


def get_git_commit_hash():
    try:
        return subprocess.check_output(
            ["git", "rev-parse", "HEAD"], stderr=subprocess.DEVNULL
        ).decode().strip()
    except Exception:
        return "unknown (not a git repo, or git unavailable)"


def build_run_fingerprint(cfg, manifest_path, code_version=None, extra=None):
    fp = {
        "config": cfg,
        "split_hash": hash_manifest_split(manifest_path),
        "git_commit": get_git_commit_hash(),
        "code_version": code_version or "unspecified",
        "torch_version": torch.__version__,
    }
    if extra:
        fp["extra"] = extra
    fp["fingerprint_hash"] = _stable_hash(fp)
    return fp


def fingerprint_matches(run_dir, expected_fp):
    fp_path = os.path.join(run_dir, "fingerprint.json")
    if not os.path.exists(fp_path):
        return False, "no fingerprint.json found"
    with open(fp_path) as f:
        saved_fp = json.load(f)
    if saved_fp.get("fingerprint_hash") != expected_fp["fingerprint_hash"]:
        return False, "fingerprint mismatch"
    return True, "ok"


def save_fingerprint(run_dir, fp):
    os.makedirs(run_dir, exist_ok=True)
    with open(os.path.join(run_dir, "fingerprint.json"), "w") as f:
        json.dump(fp, f, indent=2, default=str)


def validate_percase_csv(csv_path, expected_case_ids, expected_classes,
                          metric_ranges=None):
    metric_ranges = metric_ranges or {
        "dice": (0.0, 1.0), "hd95": (0.0, None), "assd": (0.0, None),
    }
    problems = []
    if not os.path.exists(csv_path):
        return False, ["file does not exist"]
    try:
        df = pd.read_csv(csv_path)
    except Exception as e:
        return False, [f"unreadable / corrupt CSV: {e}"]

    expected_rows = len(expected_case_ids) * len(expected_classes)
    if len(df) != expected_rows:
        problems.append(f"expected {expected_rows} rows, found {len(df)}")

    found_ids = set(df["case_id"].astype(str)) if "case_id" in df.columns else set()
    expected_ids_str = set(map(str, expected_case_ids))
    if expected_ids_str - found_ids:
        problems.append(f"missing case_ids: {sorted(expected_ids_str - found_ids)[:5]}")
    if found_ids - expected_ids_str:
        problems.append(f"unexpected case_ids: {sorted(found_ids - expected_ids_str)[:5]}")

    found_classes = set(df["klass_name"].unique()) if "klass_name" in df.columns else set()
    if set(expected_classes) - found_classes:
        problems.append(f"missing classes: {set(expected_classes) - found_classes}")

    for metric, (lo, hi) in metric_ranges.items():
        if metric not in df.columns:
            continue
        vals = df[metric].dropna()
        if lo is not None and (vals < lo).any():
            problems.append(f"{metric} has values below {lo}")
        if hi is not None and (vals > hi).any():
            problems.append(f"{metric} has values above {hi}")

    return (len(problems) == 0), problems


