# 4. METRICS  (from multiseed_pipeline.py)
# =============================================================================
def dice_bin(p, t, eps=1e-6):
    p, t = p.astype(bool), t.astype(bool)
    return float((2 * (p & t).sum() + eps) / (p.sum() + t.sum() + eps))


def _surface_distances(p, t, spacing=(1.0, 1.0, 1.0)):
    p, t = p.astype(bool), t.astype(bool)
    if p.sum() == 0 or t.sum() == 0:
        return np.array([])
    dt_t = distance_transform_edt(~t, sampling=spacing)
    dt_p = distance_transform_edt(~p, sampling=spacing)
    se = np.ones((3, 3, 3), dtype=bool)
    sp = p & ~binary_erosion(p, se)
    st = t & ~binary_erosion(t, se)
    return np.concatenate([dt_t[sp], dt_p[st]])


def hd95_bin(p, t, spacing=(1.0, 1.0, 1.0)):
    d = _surface_distances(p, t, spacing)
    return float(np.percentile(d, 95)) if d.size else float("nan")


def assd_bin(p, t, spacing=(1.0, 1.0, 1.0)):
    d = _surface_distances(p, t, spacing)
    return float(np.mean(d)) if d.size else float("nan")


@torch.no_grad()
def evaluate_per_subject(model, loader, device, class_names=CLASS_NAMES):
    model.eval()
    rows = []
    for imgs, targets, edts, sids, spacings in loader:
        imgs = imgs.to(device)
        pred_bin = (torch.sigmoid(model(imgs)) > 0.5).float()
        pred_np = pred_bin[0].cpu().numpy().astype(np.uint8)
        gt_np = targets[0].cpu().numpy().astype(np.uint8)
        spacing = tuple(spacings[0].cpu().numpy())
        for c, cname in enumerate(class_names):
            p, t = pred_np[c], gt_np[c]
            rows.append({"case_id": sids[0], "klass": cname,
                          "dice": dice_bin(p, t),
                          "hd95": hd95_bin(p, t, spacing),
                          "assd": assd_bin(p, t, spacing)})
    return pd.DataFrame(rows)


# =============================================================================
# 5. BASE BLOCKS  (from models_phase1.py)
# =============================================================================
def _effective_groups(groups, channels):
    if groups is None or groups <= 0:
        return 1
    g = min(groups, channels)
    while channels % g != 0 and g > 1:
        g -= 1
    return g


class ResidualBlock3D(nn.Module):
    def __init__(self, in_ch, out_ch, dropout_rate, groups):
        super().__init__()
        eg = _effective_groups(groups, out_ch)
        self.conv1 = nn.Conv3d(in_ch, out_ch, 3, padding=1, bias=False)
        self.gn1 = nn.GroupNorm(eg, out_ch)
        self.relu = nn.ReLU(inplace=True)
        self.conv2 = nn.Conv3d(out_ch, out_ch, 3, padding=1, bias=False)
        self.gn2 = nn.GroupNorm(eg, out_ch)
        self.dropout = nn.Dropout3d(dropout_rate)
        self.shortcut = (nn.Sequential(nn.Conv3d(in_ch, out_ch, 1, bias=False),
                                        nn.GroupNorm(eg, out_ch))
                          if in_ch != out_ch else nn.Identity())

    def forward(self, x):
        identity = self.shortcut(x)
        out = self.relu(self.gn1(self.conv1(x)))
        out = self.dropout(out)
        out = self.gn2(self.conv2(out))
        return self.relu(out + identity)


class TraditionalConvBlock3D(nn.Module):
    def __init__(self, in_ch, out_ch, groups):
        super().__init__()
        eg = _effective_groups(groups, out_ch)
        self.block = nn.Sequential(
            nn.Conv3d(in_ch, out_ch, 3, padding=1, bias=False),
            nn.GroupNorm(eg, out_ch), nn.ReLU(inplace=True),
            nn.Conv3d(out_ch, out_ch, 3, padding=1, bias=False),
            nn.GroupNorm(eg, out_ch), nn.ReLU(inplace=True),
        )

    def forward(self, x):
        return self.block(x)


class HybridResUNet3DBase(nn.Module):
    def __init__(self, cfg):
        super().__init__()
        f, g, drop = cfg["init_features"], cfg["norm_groups"], cfg["dropout_rate"]
        self.enc1 = ResidualBlock3D(cfg["in_channels"], f, drop, g)
        self.pool1 = nn.MaxPool3d(2)
        self.enc2 = ResidualBlock3D(f, f * 2, drop, g)
        self.pool2 = nn.MaxPool3d(2)
        self.enc3 = ResidualBlock3D(f * 2, f * 4, drop, g)
        self.pool3 = nn.MaxPool3d(2)
        self.bottleneck = ResidualBlock3D(f * 4, f * 8, drop, g)
        self.up3 = nn.ConvTranspose3d(f * 8, f * 4, 2, stride=2)
        self.dec3 = TraditionalConvBlock3D(f * 8, f * 4, g)
        self.up2 = nn.ConvTranspose3d(f * 4, f * 2, 2, stride=2)
        self.dec2 = TraditionalConvBlock3D(f * 4, f * 2, g)
        self.up1 = nn.ConvTranspose3d(f * 2, f, 2, stride=2)
        self.dec1 = TraditionalConvBlock3D(f * 2, f, g)
        self._init_weights()

    def _init_weights(self):
        for m in self.modules():
            if isinstance(m, nn.Conv3d):
                nn.init.kaiming_normal_(m.weight, mode="fan_out", nonlinearity="relu")
            elif isinstance(m, nn.GroupNorm):
                nn.init.constant_(m.weight, 1)
                nn.init.constant_(m.bias, 0)

    def encode(self, x):
        s1 = self.enc1(x)
        s2 = self.enc2(self.pool1(s1))
        s3 = self.enc3(self.pool2(s2))
        b = self.bottleneck(self.pool3(s3))
        return s1, s2, s3, b

    def decode(self, b, s1, s2, s3):
        d3 = self.dec3(torch.cat([s3, self.up3(b)], dim=1))
        d2 = self.dec2(torch.cat([s2, self.up2(d3)], dim=1))
        d1 = self.dec1(torch.cat([s1, self.up1(d2)], dim=1))
        return d1


# =============================================================================
# 6. BASE WINDOW ATTENTION  (from models_phase1_swin.py)
# =============================================================================
class WindowAttention3D(nn.Module):
    def __init__(self, dim, window_size, num_heads=4, qkv_bias=True,
                 attn_drop=0.0, proj_drop=0.0):
        super().__init__()
        self.dim = dim
        self.window_size = window_size
        self.num_heads = num_heads
        head_dim = dim // num_heads
        self.scale = head_dim ** -0.5
        self.relative_position_bias_table = nn.Parameter(
            torch.zeros((2 * window_size[0] - 1)
                        * (2 * window_size[1] - 1)
                        * (2 * window_size[2] - 1), num_heads))
        nn.init.trunc_normal_(self.relative_position_bias_table, std=0.02)

        coords_d = torch.arange(window_size[0])
        coords_h = torch.arange(window_size[1])
        coords_w = torch.arange(window_size[2])
        coords = torch.stack(torch.meshgrid(coords_d, coords_h, coords_w, indexing="ij"))
        coords_flatten = torch.flatten(coords, 1)
        relative_coords = coords_flatten[:, :, None] - coords_flatten[:, None, :]
        relative_coords = relative_coords.permute(1, 2, 0).contiguous()
        relative_coords[:, :, 0] += window_size[0] - 1
        relative_coords[:, :, 1] += window_size[1] - 1
        relative_coords[:, :, 2] += window_size[2] - 1
        relative_coords[:, :, 0] *= (2 * window_size[1] - 1) * (2 * window_size[2] - 1)
        relative_coords[:, :, 1] *= (2 * window_size[2] - 1)
        relative_position_index = relative_coords.sum(-1)
        self.register_buffer("relative_position_index", relative_position_index)

        self.qkv = nn.Linear(dim, dim * 3, bias=qkv_bias)
        self.attn_drop = nn.Dropout(attn_drop)
        self.proj = nn.Linear(dim, dim)
        self.proj_drop = nn.Dropout(proj_drop)
        self.softmax = nn.Softmax(dim=-1)

    def forward(self, x):
        B_, N, C = x.shape
        qkv = self.qkv(x).reshape(B_, N, 3, self.num_heads, C // self.num_heads).permute(2, 0, 3, 1, 4)
        q, k, v = qkv[0], qkv[1], qkv[2]
        q = q * self.scale
        attn = q @ k.transpose(-2, -1)
        bias = self.relative_position_bias_table[self.relative_position_index.view(-1)]
        bias = bias.view(N, N, -1).permute(2, 0, 1).contiguous()
        attn = attn + bias.unsqueeze(0)
        attn = self.softmax(attn)
        attn = self.attn_drop(attn)
        x = (attn @ v).transpose(1, 2).reshape(B_, N, C)
        x = self.proj(x)
        x = self.proj_drop(x)
        return x


# =============================================================================
# 7. PG-SWIN MODEL  (from models_pgswin.py)
# =============================================================================
def _wpart(x, ws):
    B, D, H, W, C = x.shape
    wd, wh, ww = ws
    x = x.reshape(B, D // wd, wd, H // wh, wh, W // ww, ww, C)
    return x.permute(0, 1, 3, 5, 2, 4, 6, 7).reshape(-1, wd * wh * ww, C)


def _wrev(w, ws, B, D, H, W):
    wd, wh, ww = ws
    C = w.shape[-1]
    x = w.reshape(B, D // wd, H // wh, W // ww, wd, wh, ww, C)
    return x.permute(0, 1, 4, 2, 5, 3, 6, 7).reshape(B, D, H, W, C)


def _shift_mask(Dp, Hp, Wp, ws, ss, device):
    img = torch.zeros(1, Dp, Hp, Wp, 1, device=device)

    def sl(w, s):
        return (slice(0, -w), slice(-w, -s), slice(-s, None)) if s > 0 else (slice(None),)

    cnt = 0
    for d in sl(ws[0], ss[0]):
        for h in sl(ws[1], ss[1]):
            for w_ in sl(ws[2], ss[2]):
                img[:, d, h, w_, :] = cnt
                cnt += 1
    mw = _wpart(img, ws).squeeze(-1)
    m = mw.unsqueeze(1) - mw.unsqueeze(2)
    return m.masked_fill(m != 0, -100.0).masked_fill(m == 0, 0.0)


class MaskedWindowAttention3D(WindowAttention3D):
    def forward(self, x, mask=None):
        B_, N, C = x.shape
        qkv = self.qkv(x).reshape(B_, N, 3, self.num_heads, C // self.num_heads).permute(2, 0, 3, 1, 4)
        q, k, v = qkv[0], qkv[1], qkv[2]
        attn = (q * self.scale) @ k.transpose(-2, -1)
        bias = self.relative_position_bias_table[self.relative_position_index.view(-1)]
        attn = attn + bias.view(N, N, -1).permute(2, 0, 1).contiguous().unsqueeze(0)
        if mask is not None:
            nW = mask.shape[0]
            attn = attn.view(B_ // nW, nW, self.num_heads, N, N) + mask.unsqueeze(1).unsqueeze(0)
            attn = attn.view(-1, self.num_heads, N, N)
        attn = self.attn_drop(self.softmax(attn))
        x = (attn @ v).transpose(1, 2).reshape(B_, N, C)
        return self.proj_drop(self.proj(x))


class SwinBlock3D(nn.Module):
    def __init__(self, dim, heads, ws, shift, mlp_ratio=2.0, drop=0.1, ls_init=0.1):
        super().__init__()
        self.ws, self.shift = ws, shift
        self.norm1 = nn.LayerNorm(dim)
        self.attn = MaskedWindowAttention3D(dim, ws, heads, qkv_bias=True,
                                             attn_drop=0.0, proj_drop=drop)
        self.norm2 = nn.LayerNorm(dim)
        hid = int(dim * mlp_ratio)
        self.mlp = nn.Sequential(nn.Linear(dim, hid), nn.GELU(), nn.Dropout(drop),
                                 nn.Linear(hid, dim), nn.Dropout(drop))
        self.g1 = nn.Parameter(ls_init * torch.ones(dim))
        self.g2 = nn.Parameter(ls_init * torch.ones(dim))
        self._mask_cache = {}

    def _mask(self, Dp, Hp, Wp, ss, device):
        key = (Dp, Hp, Wp, ss, str(device))
        if key not in self._mask_cache:
            self._mask_cache[key] = _shift_mask(Dp, Hp, Wp, self.ws, ss, device)
        return self._mask_cache[key]

    def forward(self, x):
        B, D, H, W, C = x.shape
        wd, wh, ww = self.ws
        pd_, ph, pw = (-D) % wd, (-H) % wh, (-W) % ww
        h = self.norm1(x)
        if pd_ or ph or pw:
            h = F.pad(h, (0, 0, 0, pw, 0, ph, 0, pd_))
        Dp, Hp, Wp = D + pd_, H + ph, W + pw
        ss = ((wd // 2 if Dp > wd else 0,
               wh // 2 if Hp > wh else 0,
               ww // 2 if Wp > ww else 0) if self.shift else (0, 0, 0))
        mask = None
        if any(ss):
            h = torch.roll(h, shifts=(-ss[0], -ss[1], -ss[2]), dims=(1, 2, 3))
            mask = self._mask(Dp, Hp, Wp, ss, x.device)
        h = self.attn(_wpart(h, self.ws), mask)
        h = _wrev(h, self.ws, B, Dp, Hp, Wp)
        if any(ss):
            h = torch.roll(h, shifts=ss, dims=(1, 2, 3))
        h = h[:, :D, :H, :W, :]
        x = x + self.g1 * h
        return x + self.g2 * self.mlp(self.norm2(x))


class SwinStage3D(nn.Module):
    def __init__(self, dim, heads=4, ws=(2, 4, 4), depth=2, drop=0.1):
        super().__init__()
        self.blocks = nn.ModuleList([
            SwinBlock3D(dim, heads, ws, shift=(i % 2 == 1), drop=drop)
            for i in range(depth)])

    def forward(self, x):
        x = x.permute(0, 2, 3, 4, 1).contiguous()
        for blk in self.blocks:
            x = blk(x)
        return x.permute(0, 4, 1, 2, 3).contiguous()


class PrototypeHead3D(nn.Module):
    def __init__(self, c_bott, c_feat, num_classes=2, protos_per_class=2,
                 heads=4, drop=0.1, tau_init=10.0, gamma_init=0.1):
        super().__init__()
        self.K, self.P = num_classes, protos_per_class
        self.proto = nn.Parameter(torch.randn(self.K * self.P, c_bott) * 0.02)
        self.norm_q = nn.LayerNorm(c_bott)
        self.norm_kv = nn.LayerNorm(c_bott)
        self.xattn = nn.MultiheadAttention(c_bott, heads, dropout=drop, batch_first=True)
        self.norm_f = nn.LayerNorm(c_bott)
        self.ffn = nn.Sequential(nn.Linear(c_bott, 2 * c_bott), nn.GELU(),
                                 nn.Linear(2 * c_bott, c_bott))
        self.to_feat = nn.Linear(c_bott, c_feat)
        self.pix_proj = nn.Conv3d(c_feat, c_feat, 1)
        self.log_tau = nn.Parameter(torch.tensor(math.log(tau_init)))
        self.gamma = nn.Parameter(torch.tensor(float(gamma_init)))

    def forward(self, bott, d1):
        B = bott.shape[0]
        tok = self.norm_kv(bott.flatten(2).transpose(1, 2))
        q = self.proto.unsqueeze(0).expand(B, -1, -1)
        a, _ = self.xattn(self.norm_q(q), tok, tok, need_weights=False)
        p = q + a
        p = p + self.ffn(self.norm_f(p))
        p = F.normalize(self.to_feat(p), dim=-1)
        f = F.normalize(self.pix_proj(d1), dim=1)
        sim = torch.einsum("bfdhw,bpf->bpdhw", f, p)
        sim = sim.reshape(B, self.K, self.P, *sim.shape[2:]).amax(2)
        return self.gamma * self.log_tau.exp() * sim


class PGSwinUNet3D(HybridResUNet3DBase):
    def __init__(self, cfg, use_swin=True, use_proto=True, deep_sup=True,
                 swin_window=(2, 4, 4), swin_heads=4, swin_depth=2,
                 protos_per_class=2):
        super().__init__(cfg)
        f, out_ch = cfg["init_features"], cfg["num_classes"]
        self.use_swin, self.use_proto, self.deep_sup = use_swin, use_proto, deep_sup
        if use_swin:
            self.swin = SwinStage3D(f * 8, swin_heads, swin_window, swin_depth, drop=0.1)
        if use_proto:
            self.proto = PrototypeHead3D(f * 8, f, out_ch, protos_per_class)
        self.final_conv = nn.Conv3d(f, out_ch, 1)
        if deep_sup:
            self.aux3 = nn.Conv3d(f * 4, out_ch, 1)
            self.aux2 = nn.Conv3d(f * 2, out_ch, 1)
        self._init_weights()

    def forward(self, x):
        s1, s2, s3, b = self.encode(x)
        if self.use_swin:
            b = self.swin(b)
        d3 = self.dec3(torch.cat([s3, self.up3(b)], 1))
        d2 = self.dec2(torch.cat([s2, self.up2(d3)], 1))
        d1 = self.dec1(torch.cat([s1, self.up1(d2)], 1))
        logits = self.final_conv(d1)
        if self.use_proto:
            logits = logits + self.proto(b, d1)
        if self.training and self.deep_sup:
            sz = logits.shape[2:]
            aux = [F.interpolate(self.aux2(d2), size=sz, mode="trilinear", align_corners=False),
                   F.interpolate(self.aux3(d3), size=sz, mode="trilinear", align_corners=False)]
            return logits, aux
        return logits


# =============================================================================
# 8. LOSS  (from shared_losses.py)
# =============================================================================
class BCEDiceLoss(nn.Module):
    def __init__(self, smooth=1e-5, bce_weight=1.0, dice_weight=1.0):
        super().__init__()
        self.smooth = smooth
        self.bce_weight = bce_weight
        self.dice_weight = dice_weight

    def forward(self, logits, targets, edt_maps=None):
        probs = torch.sigmoid(logits)
        inter = torch.sum(probs * targets, dim=(2, 3, 4))
        card = torch.sum(probs + targets, dim=(2, 3, 4)) + self.smooth
        dice_loss = 1.0 - (2.0 * inter + self.smooth) / card
        bce = F.binary_cross_entropy_with_logits(logits, targets, reduction="mean")
        return self.bce_weight * bce + self.dice_weight * dice_loss.mean()


