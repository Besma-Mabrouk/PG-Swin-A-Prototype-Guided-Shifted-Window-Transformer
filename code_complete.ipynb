# 3. DATA LOADING  (from multiseed_pipeline.py)
# =============================================================================
def load_from_manifest_npz_with_ids(manifest_path, npz_root,
                                     splits=("train", "val", "test")):
    df = pd.read_csv(manifest_path)
    df_ok = df[df["excluded"] == False]
    out = {}
    for split in splits:
        ids = df_ok[df_ok["split"] == split]["original_id"].tolist()
        if not ids:
            print(f"[warn] no subjects for split='{split}'")
            continue
        images, labels, spacings = [], [], []
        for sid in tqdm(ids, desc=f"Loading {split}"):
            d = np.load(os.path.join(npz_root, f"{sid}.npz"))
            img, lab = d["img"], d["lab"]
            lab_multi = np.stack([(lab == 1).astype(np.float32),
                                   (lab == 2).astype(np.float32)], axis=-1)
            images.append(np.expand_dims(img, axis=-1))
            labels.append(lab_multi)
            spacings.append(tuple(float(v) for v in d["spacing"]))
        out[split] = (np.array(images, dtype=np.float32),
                      np.array(labels, dtype=np.float32),
                      ids, spacings)
        print(f"[{split}] {len(ids)} subjects")
    return out


def audit_empty_masks(data):
    for split, (imgs, labs, ids, sp) in data.items():
        empty = [sid for i, sid in enumerate(ids) if labs[i].sum() == 0]
        if empty:
            print(f"[audit_empty_masks] WARNING: {len(empty)} empty-mask "
                  f"subjects in '{split}': {empty[:5]}")
        else:
            print(f"[audit_empty_masks] '{split}': no empty masks "
                  f"({len(ids)} subjects)")


def compute_edt_3d(mask_multichannel, spacing=(1.0, 1.0, 1.0)):
    dist = np.full_like(mask_multichannel, 50.0, dtype=np.float32)
    for ch in range(mask_multichannel.shape[0]):
        m = mask_multichannel[ch] > 0.5
        if np.any(m) and not np.all(m):
            dist_out = distance_transform_edt(~m, sampling=spacing)
            dist_in  = distance_transform_edt(m,  sampling=spacing)
            dist[ch] = dist_out + dist_in
    return dist


class ECDFEDTDataset(Dataset):
    def __init__(self, images, labels, subject_ids, spacings):
        self.images = images
        self.labels = labels
        self.subject_ids = subject_ids
        self.spacings = spacings
        self.edt_maps = []
        for lab, sp in zip(labels, spacings):
            lab_t = lab.transpose(3, 2, 0, 1)
            sx, sy, sz = sp
            self.edt_maps.append(compute_edt_3d(lab_t, spacing=(sz, sx, sy)))

    def __len__(self):
        return len(self.images)

    def __getitem__(self, idx):
        img = self.images[idx].transpose(3, 2, 0, 1)
        lab = self.labels[idx].transpose(3, 2, 0, 1)
        edt = self.edt_maps[idx]
        return (torch.tensor(img, dtype=torch.float32),
                torch.tensor(lab, dtype=torch.float32),
                torch.tensor(edt, dtype=torch.float32),
                self.subject_ids[idx],
                torch.tensor(self.spacings[idx], dtype=torch.float32))


def make_loaders(data, batch_size, eval_batch_size=1):
    loaders = {}
    for split in ("train", "val", "test"):
        if split not in data:
            continue
        ds = ECDFEDTDataset(*data[split])
        loaders[split] = DataLoader(
            ds,
            batch_size=batch_size if split == "train" else eval_batch_size,
            shuffle=(split == "train"),
            num_workers=2,
            pin_memory=True,
        )
    return loaders


