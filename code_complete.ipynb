# 12. MAIN
# =============================================================================
def main():
    CFG = dict(
        manifest_path=MANIFEST_PATH, npz_root=NPZ_CACHE_ROOT,
        num_classes=2, in_channels=1, init_features=16,
        batch_size=2, epochs=50, lr=5e-4, weight_decay=1e-4,
        dropout_rate=0.2, norm_groups=8,
    )
    run_pgswin(CFG, seeds=SEEDS, only_arms=list(VARIANTS))
    main_df, stats_df = compute_pairwise_statistics()
    print(main_df.to_string(index=False))
    print()
    print(stats_df[["klass", "comparison", "mean_delta", "ci95_low",
                     "ci95_high", "cohens_d", "p_raw", "p_holm",
                     "sig_holm"]].to_string(index=False))
    print(f"\nAll outputs under: {PG_ROOT}")


if __name__ == "__main__":
    main()
