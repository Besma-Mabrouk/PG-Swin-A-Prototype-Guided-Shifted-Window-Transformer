# 9. STATISTICS  (from multiseed_pipeline.py)
# =============================================================================
def adjust_pvalues(p_values):
    m = len(p_values)
    p_arr = np.array(p_values)
    sorted_idx = np.argsort(p_arr)
    p_sorted = p_arr[sorted_idx]
    p_holm_sorted = np.zeros(m)
    for k in range(m):
        p_holm_sorted[k] = min(1.0, max(p_holm_sorted[k - 1] if k > 0 else 0.0,
                                          (m - k) * p_sorted[k]))
    p_holm = np.zeros(m)
    p_holm[sorted_idx] = p_holm_sorted
    p_bh_sorted = np.zeros(m)
    for k in range(m - 1, -1, -1):
        p_bh_sorted[k] = (p_sorted[k] if k == m - 1
                           else min(p_bh_sorted[k + 1], (m / (k + 1)) * p_sorted[k]))
    p_bh = np.zeros(m)
    p_bh[sorted_idx] = p_bh_sorted
    return p_holm, p_bh


def cohens_d_paired(diff):
    diff = np.asarray(diff, dtype=float)
    sd = diff.std(ddof=1)
    return float(diff.mean() / sd) if sd > 1e-8 else float("nan")


def seed_level_table(alld):
    return (alld.groupby(["optim_method", "klass_name", "seed"])
                .agg(seed_mean_dice=("dice", "mean"),
                     seed_mean_hd95=("hd95", "mean"),
                     seed_mean_assd=("assd", "mean"))
                .reset_index())


def paired_seed_level_test(seed_level, method_a, method_b, klass,
                            metric="seed_mean_dice"):
    a = seed_level[(seed_level.optim_method == method_a) &
                    (seed_level.klass_name == klass)].set_index("seed")[metric]
    b = seed_level[(seed_level.optim_method == method_b) &
                    (seed_level.klass_name == klass)].set_index("seed")[metric]
    common = a.index.intersection(b.index)
    a, b = a.loc[common], b.loc[common]
    diff = (a - b).values
    p_raw = (float(stats.wilcoxon(a.values, b.values).pvalue)
             if len(diff) > 1 and not np.allclose(diff, 0) else 1.0)
    return dict(n=len(diff),
                mean_delta=float(diff.mean()) if len(diff) else float("nan"),
                cohens_d=cohens_d_paired(diff) if len(diff) else float("nan"),
                p_raw=p_raw)


def hierarchical_bootstrap(alld, method_a, method_b, klass,
                            n_boot=5000, seed0=0, metric="dice"):
    rng = np.random.default_rng(seed0)
    sub_a = alld[(alld.optim_method == method_a) & (alld.klass_name == klass)]
    sub_b = alld[(alld.optim_method == method_b) & (alld.klass_name == klass)]
    seeds_common = sorted(set(sub_a.seed) & set(sub_b.seed))
    if len(seeds_common) < 2:
        return dict(ci95_low=float("nan"), ci95_high=float("nan"))
    boots = []
    for _ in range(n_boot):
        rs = rng.choice(seeds_common, size=len(seeds_common), replace=True)
        deltas = []
        for s in rs:
            ca = sub_a[sub_a.seed == s].set_index("case_id")[metric]
            cb = sub_b[sub_b.seed == s].set_index("case_id")[metric]
            common = ca.index.intersection(cb.index)
            rc = rng.choice(common, size=len(common), replace=True)
            deltas.append((ca.loc[rc].values - cb.loc[rc].values).mean())
        boots.append(float(np.mean(deltas)))
    lo, hi = np.percentile(boots, [2.5, 97.5])
    return dict(ci95_low=float(lo), ci95_high=float(hi))


