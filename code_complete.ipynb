# 11. STATISTICS DRIVER  (from pgswin_colab.ipynb Cell 5)
# =============================================================================
def _load_percase(pattern, label=None):
    files = sorted(glob.glob(pattern))
    if not files:
        raise FileNotFoundError(f"nothing found for {pattern}")
    d = pd.concat([pd.read_csv(f) for f in files], ignore_index=True)
    if label:
        d["optim_method"] = label
    return d


def compute_pairwise_statistics():
    """Reproduce Cell 5 of pgswin_colab.ipynb: load all per-case CSVs and
    run the paired comparisons that appear in the manuscript's results."""
    pg = _load_percase(os.path.join(PG_ROOT, "tables", "per_case_*.csv"))
    base = _load_percase(
        os.path.join(RESULTS_ROOT, "phase1_architecture_ablation", "tables",
                     "per_case_baseline_seed*.csv"), "baseline")
    sw1 = _load_percase(
        os.path.join(RESULTS_ROOT, "phase1_swin_bottleneck", "tables",
                     "per_case_*.csv"), "swin_bottleneck")

    alld = pd.concat([pg, base, sw1], ignore_index=True)
    slevel = seed_level_table(alld)

    comparisons = [
        ("pgswin_full", "baseline"),
        ("pgswin_full", "swin_bottleneck"),
        ("pgswin_full", "ctrl_ds_ema"),
        ("ctrl_ds_ema", "baseline"),
        ("sw_swin", "swin_bottleneck"),
        ("sw_swin_proto", "sw_swin"),
    ]
    present = set(alld.optim_method.unique())
    rows = []
    for a, b in comparisons:
        if a not in present or b not in present:
            continue
        for kl in CLASS_NAMES:
            r = paired_seed_level_test(slevel, a, b, kl)
            bt = hierarchical_bootstrap(alld, a, b, kl)
            rows.append(dict(klass=kl, comparison=f"{a} vs {b}", **r, **bt))
    stats_df = pd.DataFrame(rows)
    stats_df["p_holm"], stats_df["p_bh_fdr"] = adjust_pvalues(
        stats_df["p_raw"].tolist())
    stats_df["sig_holm"] = np.where(stats_df["p_holm"] < 0.05, "YES", "NO")

    main_rows = []
    for kl in CLASS_NAMES:
        for m in ["baseline", "swin_bottleneck"] + list(VARIANTS.keys()):
            if m not in present:
                continue
            s = slevel[(slevel.optim_method == m) & (slevel.klass_name == kl)]
            if len(s):
                main_rows.append(dict(
                    klass=kl, method=m, n=s.seed.nunique(),
                    dice=f"{s.seed_mean_dice.mean():.4f} +- "
                         f"{s.seed_mean_dice.std(ddof=1):.4f}",
                    hd95=f"{s.seed_mean_hd95.mean():.3f}",
                    assd=f"{s.seed_mean_assd.mean():.4f}"))
    main_df = pd.DataFrame(main_rows)

    main_df.to_csv(os.path.join(PG_ROOT, "tables", "pgswin_results.csv"), index=False)
    stats_df.to_csv(os.path.join(PG_ROOT, "tables", "pgswin_pairwise.csv"), index=False)
    return main_df, stats_df


